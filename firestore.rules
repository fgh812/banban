rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }
    // 내 프로필 (어느 가계부에 속했는지)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // 초대 코드: 코드를 아는 로그인 사용자는 읽을 수 있음
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && isMember(resource.data.hid);
      allow delete: if false;
    }
    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn() && request.resource.data.memberUids == [request.auth.uid];
      // 구성원은 자유롭게 수정. 초대 코드로 참여하는 사람은 자기 uid를 memberUids 에 더하고 persons 를 연결하는 것만 허용
      allow update: if isMember(hid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'persons', 'joinCode'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.hid == hid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.active == true);
      allow delete: if false;
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
